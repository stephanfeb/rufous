{"id": "zed-2026-10-31/459", "tool": "run_bash", "args": {"command": "cat > {workdir}/lib/content/lib/block_store.dart << 'DARTEOF'\nimport 'dart:io';\nimport 'dart:typed_data';\n\nimport 'package:dcid/dcid.dart' as dart_cid;\n\n/// A flat directory block store that uses the CID string as the filename.\nclass DirectoryBlockStore {\n  final Directory _dir;\n  DirectoryBlockStore(this._dir);\n  \n  File _file(dart_cid.CID cid) => File('$_dir.path/${cid.toString()}');\n  \n  Future<bool> has(dart_cid.CID cid) async {\n    return await _file(cid).exists();\n  }\n  \n  Future<Uint8List?> get(dart_cid.CID cid) async {\n    final f = _file(cid);\n    if (await f.exists()) {\n      return await f.readAsBytes();\n    }\n    return null;\n  }\n  \n  Future<void> put(dart_cid.CID cid, Uint8List data) async {\n    final f = _file(cid);\n    await f.writeAsBytes(data, flush: true);\n  }\n}\n\nclass SizedBlockStore extends DirectoryBlockStore {\n  final Map<String, int> _sizes = {};\n  \n  Future<int?> getSize(dart_cid.CID cid) async => _sizes[cid.toString()];\n  \n  void registerSize(dart_cid.CID cid, int size) => _sizes[cid.toString()] = size;\n}\nDARTEOF"}, "expect": "as_written"}
