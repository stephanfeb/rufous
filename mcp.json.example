{
  "utils": {
    "command": "python",
    "args": ["mcp_utils_server.py"],
    "categories": ["MCP"]
  },
  "filesystem": {
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-filesystem", "C:/work"],
    "categories": ["files"]
  },
  "big_server": {
    "command": "python",
    "args": ["C:/path/to/my_big_server.py"],
    "categories": ["files"],
    "tools": {
      "search_web": ["web"],
      "exec_sql": ["code"],
      "save_note": ["memory", "files"]
    }
  }
}
