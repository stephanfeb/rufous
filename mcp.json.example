{
  "utils": {
    "command": "python",
    "args": ["mcp_utils_server.py"],
    "categories": ["MCP"]
  },
  "filesystem": {
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-filesystem", "C:/work"],
    "categories": ["文件"]
  },
  "big_server": {
    "command": "python",
    "args": ["C:/path/to/my_big_server.py"],
    "categories": ["文件"],
    "tools": {
      "search_web": ["网络"],
      "exec_sql": ["代码"],
      "save_note": ["记忆", "文件"]
    }
  }
}
